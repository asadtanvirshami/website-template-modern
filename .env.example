# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://thewebsitegrove.com

# --- Contact form delivery (REQUIRED for the form to work; without these it returns an error, never a fake success)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="The Website Grove <noreply@thewebsitegrove.com>"   # sender on a domain verified in Resend
CONTACT_TO_EMAIL=info@thewebsitegrove.com

# --- Optional spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional analytics (GA4). Loads only after the visitor accepts.
NEXT_PUBLIC_GA_ID=
